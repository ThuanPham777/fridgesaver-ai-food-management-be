// FridgeSaver — Prisma Schema
// PostgreSQL · 18 tables

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  admin
  user
  premium
}

enum PlanType {
  free
  premium
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  trial
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentMethod {
  vnpay
  momo
}

enum HouseholdMemberRole {
  admin
  member
}

enum StorageLocation {
  fridge
  freezer
  pantry
  counter
}

enum FoodItemStatus {
  available
  used
  wasted
  expired
}

enum WasteReason {
  expired
  spoiled
  leftover
  other
}

enum RecipeDifficulty {
  easy
  medium
  hard
}

enum ShoppingListStatus {
  active
  completed
}

enum FoodSharingPostStatus {
  available
  reserved
  claimed
  expired
}

enum FoodRequestStatus {
  pending
  accepted
  rejected
  cancelled
}

enum NotificationType {
  expiry_warning
  food_request
  system
  sharing
  payment
}

enum AiFeature {
  recipe_suggestion
  image_recognition
}

enum AiUsageStatus {
  success
  failed
  rate_limited
}

// ============================================================
// Models
// ============================================================

/// Thông tin tài khoản người dùng — Auth, OAuth, Profile, Settings
model User {
  id                      String   @id @default(uuid()) @db.Uuid
  email                   String   @unique @db.VarChar(255)
  passwordHash            String?  @map("password_hash") @db.VarChar(255)
  fullName                String   @map("full_name") @db.VarChar(100)
  phone                   String?  @db.VarChar(20)
  avatarUrl               String?  @map("avatar_url") @db.VarChar(500)
  role                    UserRole @default(user)
  isEmailVerified         Boolean  @default(false) @map("is_email_verified")
  isActive                Boolean  @default(true) @map("is_active")
  address                 String?  @db.VarChar(500)
  dietaryPreferences      Json?    @map("dietary_preferences") @db.JsonB
  notificationPreferences Json     @default("{\"push_enabled\":true,\"email_enabled\":true,\"expiry_days_before\":[1,3,7],\"email_digest\":\"daily\"}") @map("notification_preferences") @db.JsonB
  language                String   @default("vi") @map("language") @db.VarChar(10)
  oauthProvider           String?  @map("oauth_provider") @db.VarChar(50)
  oauthId                 String?  @map("oauth_id") @db.VarChar(255)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  refreshTokens     RefreshToken[]
  subscriptions     Subscription[]
  payments          Payment[]
  ownedHouseholds   Household[]          @relation("HouseholdOwner")
  householdMembers  HouseholdMember[]
  foodItemsAdded    FoodItem[]           @relation("FoodItemAddedBy")
  wasteLogs         WasteLog[]           @relation("WasteLogWastedBy")
  recipes           Recipe[]
  savedRecipes      UserSavedRecipe[]
  shoppingLists     ShoppingList[]       @relation("ShoppingListCreatedBy")
  sharingPosts      FoodSharingPost[]    @relation("FoodSharingPostUser")
  claimedPosts      FoodSharingPost[]    @relation("FoodSharingPostClaimedBy")
  foodRequests      FoodRequest[]
  notifications     Notification[]
  aiUsageLogs       AiUsageLog[]

  @@map("users")
}

/// Refresh token JWT — hỗ trợ multi-device, rotation, revoke
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  device    String?  @db.VarChar(100)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

/// Gói đăng ký Free / Premium của người dùng
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  planType           PlanType           @map("plan_type")
  status             SubscriptionStatus @default(active)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

/// Lịch sử giao dịch thanh toán qua VNPay / MoMo
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("VND") @db.VarChar(10)
  status         PaymentStatus
  paymentMethod  PaymentMethod @map("payment_method")
  transactionId  String?       @map("transaction_id") @db.VarChar(255)
  metadata       Json?         @db.JsonB
  createdAt      DateTime      @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("payments")
}

/// Hộ gia đình — đơn vị chia sẻ kho thực phẩm
model Household {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(100)
  ownerId    String   @map("owner_id") @db.Uuid
  inviteCode String?  @unique @map("invite_code") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  owner         User              @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       HouseholdMember[]
  foodItems     FoodItem[]
  wasteLogs     WasteLog[]
  shoppingLists ShoppingList[]

  @@map("households")
}

/// Thành viên trong household với phân quyền admin / member
model HouseholdMember {
  id          String              @id @default(uuid()) @db.Uuid
  householdId String              @map("household_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  role        HouseholdMemberRole @default(member)
  joinedAt    DateTime            @default(now()) @map("joined_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@map("household_members")
}

/// Danh mục thực phẩm — có default_expiry_days cho AI suggest
model Category {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(100)
  icon              String?  @db.VarChar(50)
  defaultExpiryDays Int?     @map("default_expiry_days")
  createdAt         DateTime @default(now()) @map("created_at")

  foodItems         FoodItem[]
  shoppingListItems ShoppingListItem[]

  @@map("categories")
}

/// Thực phẩm trong kho — theo dõi số lượng, hạn sử dụng, vị trí lưu trữ
model FoodItem {
  id              String          @id @default(uuid()) @db.Uuid
  householdId     String          @map("household_id") @db.Uuid
  categoryId      String?         @map("category_id") @db.Uuid
  name            String          @db.VarChar(200)
  quantity        Decimal         @default(1) @db.Decimal(10, 2)
  unit            String          @default("item") @db.VarChar(20)
  expiryDate      DateTime?       @map("expiry_date") @db.Date
  storageLocation StorageLocation? @map("storage_location")
  imageUrl        String?         @map("image_url") @db.VarChar(500)
  barcode         String?         @db.VarChar(50)
  status          FoodItemStatus  @default(available)
  addedBy         String?         @map("added_by") @db.Uuid
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  addedByUser User?      @relation("FoodItemAddedBy", fields: [addedBy], references: [id], onDelete: SetNull)
  wasteLogs   WasteLog[]

  @@map("food_items")
}

/// Ghi nhận thực phẩm bị lãng phí để phân tích và báo cáo
model WasteLog {
  id             String      @id @default(uuid()) @db.Uuid
  householdId    String      @map("household_id") @db.Uuid
  foodItemId     String?     @map("food_item_id") @db.Uuid
  foodName       String      @map("food_name") @db.VarChar(200)
  quantity       Decimal     @db.Decimal(10, 2)
  unit           String?     @db.VarChar(20)
  estimatedValue Decimal?    @map("estimated_value") @db.Decimal(12, 2)
  reason         WasteReason
  wastedBy       String?     @map("wasted_by") @db.Uuid
  wastedDate     DateTime    @default(dbgenerated("CURRENT_DATE")) @map("wasted_date") @db.Date
  createdAt      DateTime    @default(now()) @map("created_at")

  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  foodItem     FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  wastedByUser User?     @relation("WasteLogWastedBy", fields: [wastedBy], references: [id], onDelete: SetNull)

  @@map("waste_logs")
}

/// Công thức nấu ăn — cả AI generated và user tự lưu
model Recipe {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String?          @map("user_id") @db.Uuid
  title         String           @db.VarChar(200)
  description   String?          @db.Text
  imageUrl      String?          @map("image_url") @db.VarChar(500)
  prepTime      Int?             @map("prep_time")
  cookTime      Int?             @map("cook_time")
  servings      Int              @default(2)
  difficulty    RecipeDifficulty @default(medium)
  cuisine       String?          @db.VarChar(50)
  dietaryTags   Json?            @map("dietary_tags") @db.JsonB
  instructions  Json             @db.JsonB
  nutrition     Json?            @db.JsonB
  isAiGenerated Boolean          @default(false) @map("is_ai_generated")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  ingredients RecipeIngredient[]
  savedBy     UserSavedRecipe[]

  @@map("recipes")
}

/// Nguyên liệu trong công thức nấu ăn
model RecipeIngredient {
  id         String   @id @default(uuid()) @db.Uuid
  recipeId   String   @map("recipe_id") @db.Uuid
  name       String   @db.VarChar(100)
  quantity   Decimal? @db.Decimal(10, 2)
  unit       String?  @db.VarChar(20)
  isOptional Boolean  @default(false) @map("is_optional")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_ingredients")
}

/// Công thức nấu ăn yêu thích đã được bookmark bởi user
model UserSavedRecipe {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@map("user_saved_recipes")
}

/// Danh sách mua sắm — chia sẻ giữa các thành viên trong household
model ShoppingList {
  id          String             @id @default(uuid()) @db.Uuid
  householdId String             @map("household_id") @db.Uuid
  name        String             @default("Shopping List") @db.VarChar(100)
  status      ShoppingListStatus @default(active)
  createdBy   String?            @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  creator   User?            @relation("ShoppingListCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items     ShoppingListItem[]

  @@map("shopping_lists")
}

/// Item trong danh sách mua sắm
model ShoppingListItem {
  id               String   @id @default(uuid()) @db.Uuid
  shoppingListId   String   @map("shopping_list_id") @db.Uuid
  name             String   @db.VarChar(200)
  quantity         Decimal  @default(1) @db.Decimal(10, 2)
  unit             String?  @db.VarChar(20)
  categoryId       String?  @map("category_id") @db.Uuid
  isChecked        Boolean  @default(false) @map("is_checked")
  addedToInventory Boolean  @default(false) @map("added_to_inventory")
  createdAt        DateTime @default(now()) @map("created_at")

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("shopping_list_items")
}

/// Bài đăng chia sẻ thực phẩm dư thừa cho cộng đồng
model FoodSharingPost {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  title          String                @db.VarChar(200)
  description    String?               @db.Text
  foodItems      Json?                 @map("food_items") @db.JsonB
  expiryDate     DateTime?             @map("expiry_date") @db.Date
  isFree         Boolean               @default(true) @map("is_free")
  price          Decimal?              @db.Decimal(12, 2)
  pickupLocation String                @map("pickup_location") @db.VarChar(500)
  pickupTimeFrom DateTime?             @map("pickup_time_from") @db.Time()
  pickupTimeTo   DateTime?             @map("pickup_time_to") @db.Time()
  images         Json?                 @db.JsonB
  status         FoodSharingPostStatus @default(available)
  claimedBy      String?               @map("claimed_by") @db.Uuid
  claimedAt      DateTime?             @map("claimed_at")
  viewCount      Int                   @default(0) @map("view_count")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  user          User          @relation("FoodSharingPostUser", fields: [userId], references: [id], onDelete: Cascade)
  claimedByUser User?         @relation("FoodSharingPostClaimedBy", fields: [claimedBy], references: [id], onDelete: SetNull)
  requests      FoodRequest[]

  @@map("food_sharing_posts")
}

/// Yêu cầu nhận thực phẩm — poster xem contact info của requester để liên hệ
model FoodRequest {
  id          String            @id @default(uuid()) @db.Uuid
  postId      String            @map("post_id") @db.Uuid
  requesterId String            @map("requester_id") @db.Uuid
  message     String?           @db.Text
  status      FoodRequestStatus @default(pending)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  post      FoodSharingPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  requester User            @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@map("food_requests")
}

/// Thông báo in-app — expiry alerts, food requests, payments
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  content   String?          @db.Text
  data      Json?            @db.JsonB
  isRead    Boolean          @default(false) @map("is_read")
  isPushed  Boolean          @default(false) @map("is_pushed")
  isEmailed Boolean          @default(false) @map("is_emailed")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// Theo dõi sử dụng AI — giới hạn Free: 5 recipes/tháng, 10 scans/tháng
model AiUsageLog {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  feature      AiFeature
  tokensUsed   Int?          @map("tokens_used")
  model        String?       @db.VarChar(50)
  requestData  Json?         @map("request_data") @db.JsonB
  responseData Json?         @map("response_data") @db.JsonB
  status       AiUsageStatus @default(success)
  durationMs   Int?          @map("duration_ms")
  createdAt    DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_usage_logs")
}

