# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Logging
LOG_LEVEL=debug

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Request Timeout (ms)
REQUEST_TIMEOUT=30000

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=API Documentation
SWAGGER_DESCRIPTION=API documentation for the application
SWAGGER_VERSION=1.0

# Add your database configuration here when needed
# DATABASE_URL=

# Add your JWT configuration here when needed
# JWT_SECRET=
# JWT_EXPIRES_IN=
