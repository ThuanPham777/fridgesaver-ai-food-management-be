# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Logging
LOG_LEVEL=debug

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Request Timeout (ms)
REQUEST_TIMEOUT=30000

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=API Documentation
SWAGGER_DESCRIPTION=API documentation for the application
SWAGGER_VERSION=1.0

# ============================
# DATABASE CONFIG (PostgreSQL)
# ============================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_management?schema=public"


# ============================
# JWT CONFIG
# ============================
JWT_ACCESS_SECRET=your-access-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Frontend URL (used for OAuth redirects and password reset links)
FRONTEND_URL=http://localhost:5173
